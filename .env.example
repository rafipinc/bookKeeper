NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Public base URL used for OAuth redirects. Set to your Vercel preview/prod URL
# (e.g. https://bookkeeping.example.com) in non-local environments.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Xero OAuth (BKP-011). Register an app at https://developer.xero.com/app/manage
# and copy the credentials. XERO_REDIRECT_URI must exactly match the one
# configured on the Xero app — typically `${NEXT_PUBLIC_APP_URL}/api/xero/callback`.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback
