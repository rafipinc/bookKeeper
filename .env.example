# Copy to .env.local for local development. On Vercel, set these under
# Project -> Settings -> Environment Variables. See docs/deployment.md.

# Supabase - https://supabase.com/dashboard/project/_/settings/api
# The NEXT_PUBLIC_ values are baked in at build time, so they must exist in
# every Vercel environment that builds (Production and Preview).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used for OAuth redirects. Leave unset on Vercel to use the
# project's production URL automatically, or set your custom domain
# (e.g. https://books.example.com). A localhost value is ignored on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Xero OAuth (BKP-011). Register an app at https://developer.xero.com/app/manage.
# XERO_REDIRECT_URI must exactly match a redirect URI on the Xero app. If unset
# it defaults to `${NEXT_PUBLIC_APP_URL}/api/xero/callback`.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback

# Inngest background jobs. Not needed locally (`pnpm dev:inngest` runs in dev
# mode). Required on Vercel: the Inngest Vercel integration sets both.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=0   # force cloud mode locally

# OpenAI - AI reconciliation suggestions and bill extraction. Optional: the
# app runs without it, minus those features.
OPENAI_API_KEY=
# OPENAI_RECONCILIATION_MODEL=gpt-4o-mini
# OPENAI_BILL_EXTRACTION_MODEL=gpt-5

# Supabase Storage bucket for bill attachments (must exist in the project).
# BILL_ATTACHMENTS_BUCKET=xero-bill-documents

# Verbose Xero/Supabase diagnostics in production logs. Leave unset normally.
# XERO_DEBUG=1
